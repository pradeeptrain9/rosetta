# Nebius Token Factory (OpenAI-compatible endpoint).
# Get a key at https://studio.nebius.com -> API keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# Optional explicit model pins. Leave blank to let `rosetta models --resolve`
# discover the served Nemotron tiers from GET /v1/models and cache them.
ROSETTA_MODEL_REASON=
ROSETTA_MODEL_FAST=
ROSETTA_MODEL_MID=

# Sandbox: "docker" (default, no local GnuCOBOL needed) or "local" (needs cobc on PATH)
ROSETTA_SANDBOX=docker
ROSETTA_SANDBOX_IMAGE=rosetta-sandbox:latest
ROSETTA_TIMEOUT_SEC=10

# Pipeline knobs
ROSETTA_TEST_VECTORS=40
ROSETTA_MAX_REPAIR_ITERS=3
